# ══════ gopet-java-api · variáveis de ambiente ══════
# Exporte estas variáveis (ou configure no seu orquestrador) antes de rodar
# `mvn spring-boot:run` — o Spring não carrega .env sozinho, isso é só
# documentação de quais variáveis o application.yml espera.

SERVER_PORT=8081

# Provider de envio de WhatsApp: zapi (padrão) ou evolution
WHATSAPP_PROVIDER=zapi

# Painel Z-API > sua instância > Segurança/Instância. Usado se WHATSAPP_PROVIDER=zapi.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Evolution API self-hospedada (https://github.com/EvolutionAPI/evolution-api).
# Usado se WHATSAPP_PROVIDER=evolution.
EVOLUTION_BASE_URL=            # ex.: https://evolution.seu-dominio.com
EVOLUTION_INSTANCE=            # nome da instância criada no painel/API da Evolution
EVOLUTION_API_KEY=

# Backend de persistência de perfis/pets/reservas: supabase (padrão, via REST/PostgREST),
# postgres (JDBC direto) ou mysql (JDBC direto, ver MYSQL_* mais abaixo — mesma conexão usada
# pro histórico de consultas de CEP). Com RESERVA_STORE=mysql, rode `mvn flyway:migrate` antes
# (cria as tabelas perfis/pets/reservas/reserva_pets, ver src/main/resources/db/migration).
RESERVA_STORE=supabase

# Painel Supabase > Settings > API. Sem isso, POST /reservas roda em modo demo (sem persistir).
# Usado se RESERVA_STORE=supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta com Postgres — usada só se RESERVA_STORE=postgres (pode ser o mesmo Postgres do
# Supabase, em Project Settings > Database > Connection string, ou um Postgres próprio).
DB_URL=                        # ex.: jdbc:postgresql://localhost:5432/gopet
DB_USERNAME=
DB_PASSWORD=

# Origem(ns) do front-end que podem chamar esta API direto do navegador (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth0 — valida o access token no POST /reservas e usa o "sub" do token como tutor_id real.
# Sem AUTH0_DOMAIN, a API roda sem exigir autenticação (mesmo comportamento de antes desta
# integração) — útil pra rodar local sem depender de um tenant Auth0.
# AUTH0_DOMAIN: painel Auth0 > Applications > Applications > sua app > Domain (ex.: seu-tenant.us.auth0.com).
AUTH0_DOMAIN=
# AUTH0_AUDIENCE: painel Auth0 > Applications > APIs > sua API > Identifier. Precisa ser IGUAL
# ao AUTH0_AUDIENCE configurado no Next.js (.env.example na raiz) — os dois lados usam o mesmo
# valor (o Next pede o token com essa audience; o java-api confere se o token tem essa audience).
AUTH0_AUDIENCE=

# CEP de referência (base) da GO PET e raio de atendimento (km) a partir dele.
COBERTURA_CEP_BASE=04321000
COBERTURA_RAIO_KM=8

# MySQL — sempre usado pro histórico de consultas de CEP (tabela consultas_cep). Também vira o
# backend de perfis/pets/reservas quando RESERVA_STORE=mysql acima. Nos dois casos, as tabelas
# são criadas via Flyway (mesmas variáveis abaixo):
#   mvn flyway:migrate
# Flyway NUNCA roda sozinho no boot da aplicação (spring.flyway.enabled=false) — é sempre manual.
# Sem MYSQL_URL: GET /cobertura funciona normalmente mas não grava histórico; com
# RESERVA_STORE=mysql, MYSQL_URL passa a ser obrigatório (perfis/pets/reservas não funcionam sem).
MYSQL_URL=                     # ex.: jdbc:mysql://localhost:3306/gopet
MYSQL_USERNAME=
MYSQL_PASSWORD=

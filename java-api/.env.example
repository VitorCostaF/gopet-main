# ══════ gopet-java-api · variáveis de ambiente ══════
# Exporte estas variáveis (ou configure no seu orquestrador) antes de rodar
# `mvn spring-boot:run` — o Spring não carrega .env sozinho, isso é só
# documentação de quais variáveis o application.yml espera.

SERVER_PORT=8081

# Provider de envio de WhatsApp: zapi (padrão) ou evolution
WHATSAPP_PROVIDER=zapi

# Painel Z-API > sua instância > Segurança/Instância. Usado se WHATSAPP_PROVIDER=zapi.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Evolution API self-hospedada (https://github.com/EvolutionAPI/evolution-api).
# Usado se WHATSAPP_PROVIDER=evolution.
EVOLUTION_BASE_URL=            # ex.: https://evolution.seu-dominio.com
EVOLUTION_INSTANCE=            # nome da instância criada no painel/API da Evolution
EVOLUTION_API_KEY=

# Backend de persistência da reserva: supabase (padrão, via REST/PostgREST) ou postgres (JDBC direto)
RESERVA_STORE=supabase

# Painel Supabase > Settings > API. Sem isso, POST /reservas roda em modo demo (sem persistir).
# Usado se RESERVA_STORE=supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta com Postgres — usada só se RESERVA_STORE=postgres (pode ser o mesmo Postgres do
# Supabase, em Project Settings > Database > Connection string, ou um Postgres próprio).
DB_URL=                        # ex.: jdbc:postgresql://localhost:5432/gopet
DB_USERNAME=
DB_PASSWORD=

# Origem(ns) do front-end que podem chamar esta API direto do navegador (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# CEP de referência (base) da GO PET e raio de atendimento (km) a partir dele.
COBERTURA_CEP_BASE=04321000
COBERTURA_RAIO_KM=8

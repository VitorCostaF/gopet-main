# ══════════════ GO PET · variáveis de ambiente ══════════════
# Copie para .env.local (dev) e configure no painel da Vercel (produção).
# ⚠️ NUNCA compartilhe estes valores em chats, e-mails ou commits.

# ── Supabase (painel > Settings > API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # SOMENTE no servidor; nunca exponha com NEXT_PUBLIC_

# ── Pagamentos ──
PAGAMENTO_PROVIDER=mock           # mock | asaas | pagarme | stripe
# ASAAS_API_KEY=
# PAGARME_SECRET=
# WEBHOOK_SECRET=                 # segredo p/ validar HMAC dos webhooks

# ── Google Maps (Fase 2: caminhada ao vivo) ──
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── gopet-java-api (backend Java separado, ver java-api/) ──
# O navegador chama esse serviço direto para a confirmação de reserva por
# WhatsApp (POST /whatsapp/reservas/confirmacao). Pública porque é usada no
# cliente. Credenciais do Z-API/Evolution ficam no .env desse serviço, não aqui.
NEXT_PUBLIC_JAVA_API_URL=http://localhost:8081

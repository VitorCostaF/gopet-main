# ══════════════ GO PET · variáveis de ambiente ══════════════
# Copie para .env.local (dev) e configure no painel da Vercel (produção).
# ⚠️ NUNCA compartilhe estes valores em chats, e-mails ou commits.

# ── Supabase — só banco de dados (Postgres), a autenticação é via Auth0 (ver abaixo) ──
# Painel Supabase > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # SOMENTE no servidor; nunca exponha com NEXT_PUBLIC_

# ── Auth0 — login/cadastro (e-mail+senha e Google) ──
# Sem essas 4 variáveis (AUTH0_DOMAIN/CLIENT_ID/CLIENT_SECRET/SECRET), o app roda em modo demo:
# sessão fake em localStorage, sem exigir um tenant Auth0 (ver lib/auth.js DEMO_MODE).
#
# 1. Crie um tenant em https://auth0.com e uma Application do tipo "Regular Web Application".
# 2. Nas configurações da Application, adicione:
#    - Allowed Callback URLs:    http://localhost:3000/auth/callback
#    - Allowed Logout URLs:      http://localhost:3000
#    - Allowed Web Origins:      http://localhost:3000
# 3. Habilite a connection "Google" (Authentication > Social) na Application — cobre o login
#    com Google. E-mail/senha já vem pronto via connection "Username-Password-Authentication".
# 4. (Só se for usar a validação de token no java-api, ver AUTH0_AUDIENCE abaixo) Crie uma API em
#    Applications > APIs, com o Identifier que você vai usar como AUTH0_AUDIENCE.
AUTH0_DOMAIN=                     # Applications > Applications > sua app > Domain
AUTH0_CLIENT_ID=                  # idem > Client ID
AUTH0_CLIENT_SECRET=              # idem > Client Secret — segredo de servidor, nunca exponha
AUTH0_SECRET=                     # string aleatória só sua, ex.: `openssl rand -hex 32`
APP_BASE_URL=http://localhost:3000
# Identifier da API cadastrada no Auth0 (passo 4 acima). Precisa ser IGUAL ao AUTH0_AUDIENCE
# configurado em java-api/.env.example — o Next pede o access token com essa audience, o
# java-api confere que o token tem essa audience (ver java-api SecurityConfig.java). Sem isso,
# o java-api não valida token nenhum (roda aberto, como hoje).
AUTH0_AUDIENCE=

# ── Pagamentos ──
PAGAMENTO_PROVIDER=mock           # mock | asaas | pagarme | stripe
# ASAAS_API_KEY=
# PAGARME_SECRET=
# WEBHOOK_SECRET=                 # segredo p/ validar HMAC dos webhooks

# ── Google Maps (Fase 2: caminhada ao vivo) ──
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── gopet-java-api (backend Java separado, ver java-api/) ──
# O navegador chama esse serviço direto para a confirmação de reserva por
# WhatsApp (POST /whatsapp/reservas/confirmacao). Pública porque é usada no
# cliente. Credenciais do Z-API/Evolution ficam no .env desse serviço, não aqui.
NEXT_PUBLIC_JAVA_API_URL=http://localhost:8081
